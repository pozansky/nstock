{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "hypotheses", "generated_factors", "risks"],
  "properties": {
    "summary": {"type": "string"},
    "hypotheses": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "rationale", "expectation"],
        "properties": {
          "candidate": {"type": "string"},
          "rationale": {"type": "string"},
          "expectation": {"type": "string"}
        }
      }
    },
    "generated_factors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "left", "operator", "right", "rationale", "expectation"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 24},
          "left": {"type": "string"},
          "operator": {"type": "string", "enum": ["multiply", "difference", "ratio", "confirm"]},
          "right": {"type": "string"},
          "rationale": {"type": "string"},
          "expectation": {"type": "string"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}, "maxItems": 5}
  }
}
